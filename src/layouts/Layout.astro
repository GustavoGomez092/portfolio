---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import pretendard200 from "@fontsource/pretendard/files/pretendard-latin-200-normal.woff2?url";
import pretendard400 from "@fontsource/pretendard/files/pretendard-latin-400-normal.woff2?url";
import Logo from "../assets/img/logo.svg?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Intro from "../components/Intro.astro";
import Mouse from "../components/Mouse.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={Logo} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Full Stack Developer portfolio showcasing web, mobile, and desktop applications. 10+ years of experience with JavaScript, TypeScript, React, and modern web technologies." />
    <link rel="canonical" href={`${Astro.site}portfolio/`} />
    <meta property="og:title" content="Gustavo Gomez - Full Stack Developer" />
    <meta property="og:description" content="Full Stack Developer portfolio showcasing web, mobile, and desktop applications." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${Astro.site}portfolio/`} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://cloud.umami.is" />
    <script type="text/partytown" src="https://cloud.umami.is/script.js" data-website-id="b7b22ced-ac21-4979-af52-ebc417013125"></script>
    <link rel="preload" href={pretendard200} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pretendard400} as="font" type="font/woff2" crossorigin />
    <title>Gustavo Gomez - Full Stack Developer</title>
    <script is:inline>
      if (navigator.webdriver === true ||
          (/Macintosh/i.test(navigator.userAgent) && /Linux/.test(navigator.platform)) ||
          (/Android/i.test(navigator.userAgent) && /Linux x86_64/.test(navigator.platform))) {
        document.documentElement.classList.add('is-speed-tool');
      }
    </script>
    <style is:inline>
      .is-speed-tool .intro { display: none !important; }
    </style>
  </head>
  <body>
		<Mouse />
    <div id="smooth-wrapper" class="site-wrapper">
      <div id="smooth-content" class="site-container">
        <Intro />
        <Header />
        <slot />
        <Footer />
      </div>
    </div>
  </body>
</html>

<script>
import { initSmoothScrolling } from "../scripts/smoothScroll.ts"

initSmoothScrolling()
</script>

<style>
  @reference "../styles/global.css";
  body {
    overflow-x: hidden;
    #smooth-wrapper {
      @apply overflow-hidden;
      #smooth-content {
        @apply overflow-hidden;
      }
    }
  }
</style>
